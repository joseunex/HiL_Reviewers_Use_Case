# Addresses and accounts of the HiL bench. Copy this file to bench.env (same folder) and fill it in.
# bench.env is read by the scripts of hil_bench/ and must not be committed.
HOST_IP=                      # host (laptop) that runs the K3s server, the local registry (port 5000),
                              # the NTP server and the Mosquitto NodePort (30100)
LAN_CIDR=                     # subnet served by the NTP server of the host, e.g. 10.0.0.0/24
RPI_IP=                       # IP of the Raspberry Pi (UserDevice node) on its wired interface
RPI_IFACE=eth0                # that interface
RPI_HOST="pi@${RPI_IP}"       # SSH user@host of the Raspberry Pi
YUN_HOST=root@arduino.local   # SSH user@host of the Linux side of the Arduino Yún
REGISTRY="${HOST_IP}:5000"    # local registry used by the Kubernetes manifests
ARDUINO_LIBS=                 # folder with the Arduino libraries used by the generator (Bridge, PubSubClient >= 2.8, TinkerKit)
